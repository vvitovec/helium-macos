+void NativeWidgetNSWindowBridge::SetWindowButtonsHidden(bool hidden) {
+  static constexpr std::array<NSWindowButton, 3> kButtons = {
+      NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton};
+  auto save_corner_state = [](NSView* view) {
+    ViewCornerState state;
+    state.wants_layer = [view wantsLayer];
+    if (CALayer* layer = [view layer]) {
+      state.corner_radius = [layer cornerRadius];
+      state.masks_to_bounds = [layer masksToBounds];
+    }
+    return state;
+  };
+  auto force_square_corners = [](NSView* view) {
+    if (!view) {
+      return;
+    }
+    [view setWantsLayer:YES];
+    view.layer.cornerRadius = 0;
+    view.layer.masksToBounds = NO;
+  };
+  auto restore_corner_state = [](NSView* view, const ViewCornerState& state) {
+    if (!view) {
+      return;
+    }
+    [view setWantsLayer:YES];
+    view.layer.cornerRadius = state.corner_radius;
+    view.layer.masksToBounds = state.masks_to_bounds;
+    [view setWantsLayer:state.wants_layer];
+  };
+
+  force_square_window_corners_ = hidden;
+  if (bridged_view_) {
+    NSView* frame_view = [bridged_view_ superview];
+    if (hidden) {
+      if (!saved_content_view_corner_state_) {
+        saved_content_view_corner_state_ = ContentViewCornerState{
+            save_corner_state(bridged_view_), save_corner_state(frame_view),
+            [window_ isOpaque], [window_ hasShadow]};
+      }
+      [window_ setOpaque:YES];
+      [window_ setHasShadow:NO];
+      force_square_corners(frame_view);
+      force_square_corners(bridged_view_);
+    } else if (saved_content_view_corner_state_) {
+      [window_ setOpaque:saved_content_view_corner_state_->window_opaque];
+      [window_
+          setHasShadow:saved_content_view_corner_state_->window_has_shadow];
+      restore_corner_state(frame_view,
+                           saved_content_view_corner_state_->frame_view);
+      restore_corner_state(bridged_view_,
+                           saved_content_view_corner_state_->bridged_view);
+      saved_content_view_corner_state_.reset();
+    }
+  }
+
+  if (hidden && !saved_window_button_state_) {
+    WindowButtonState state;
+    for (size_t i = 0; i < kButtons.size(); ++i) {
+      if (NSButton* button = [window_ standardWindowButton:kButtons[i]]) {
+        state.hidden[i] = [button isHidden];
+        state.enabled[i] = [button isEnabled];
+        state.alpha[i] = [button alphaValue];
+        state.frame[i] = [button frame];
+      }
+    }
+    saved_window_button_state_ = state;
+  }
+
+  for (size_t i = 0; i < kButtons.size(); ++i) {
+    if (NSButton* button = [window_ standardWindowButton:kButtons[i]]) {
+      if (hidden) {
+        [button setHidden:YES];
+        [button setEnabled:NO];
+        [button setAlphaValue:0.0];
+      } else if (saved_window_button_state_) {
+        if (IsUsableWindowButtonFrame(saved_window_button_state_->frame[i])) {
+          [button setFrame:saved_window_button_state_->frame[i]];
+        }
+        [button setHidden:NO];
+        [button setEnabled:YES];
+        [button setAlphaValue:1.0];
+      } else {
+        [button setHidden:NO];
+        [button setEnabled:YES];
+        [button setAlphaValue:1.0];
+      }
+    }
+  }
+
+  if (!hidden) {
+    const std::optional<WindowButtonState> restored_state =
+        saved_window_button_state_;
+    if (restored_state) {
+      NativeWidgetMacNSWindow* window = window_;
+      const WindowButtonState state = *restored_state;
+      dispatch_async(dispatch_get_main_queue(), ^{
+        for (size_t i = 0; i < kButtons.size(); ++i) {
+          if (NSButton* button = [window standardWindowButton:kButtons[i]]) {
+            if (IsUsableWindowButtonFrame(state.frame[i])) {
+              [button setFrame:state.frame[i]];
+            }
+            [button setHidden:NO];
+            [button setEnabled:YES];
+            [button setAlphaValue:1.0];
+          }
+        }
+      });
+    }
+    saved_window_button_state_.reset();
+    return;
+  }
+
+  NativeWidgetMacNSWindow* window = window_;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    for (NSWindowButton button :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      NSButton* button_view = [window standardWindowButton:button];
+      [button_view setHidden:YES];
+      [button_view setEnabled:NO];
+      [button_view setAlphaValue:0.0];
+    }
+  });
+}
