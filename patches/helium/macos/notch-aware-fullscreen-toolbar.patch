+
+bool BrowserView::ShouldUseHeliumNotchFullscreen(bool fullscreen) {
+  auto* notch_fullscreen_controller = GetHeliumNotchFullscreenController();
+  if (notch_fullscreen_controller->IsActive()) {
+    return true;
+  }
+
+  if (!fullscreen || !GetIsNormalType() ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kHeliumNotchFullscreen) ||
+      IsForceFullscreen() ||
+      platform_util::IsBrowserLockedFullscreen(browser())) {
+    return false;
+  }
+
+  auto* fullscreen_controller =
+      exclusive_access_context_->GetExclusiveAccessManager()
+          ->fullscreen_controller();
+  if (fullscreen_controller->IsWindowFullscreenForTabOrPending() ||
+      fullscreen_controller->IsExtensionFullscreenOrPending() ||
+      fullscreen_controller->IsTabFullscreen()) {
+    return false;
+  }
+
+  return notch_fullscreen_controller->CanUseNotchFullscreen();
+}
+#endif
