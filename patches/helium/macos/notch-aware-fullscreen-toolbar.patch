+  auto hide_browser_child = [&](views::View* view) {
+    if (IsParentedTo(view, views().browser_view)) {
+      layout.AddChild(view, gfx::Rect(), false);
+    }
+  };
+
+  auto hide_top_container_child = [&](ProposedLayout& top_container_layout,
+                                      views::View* view,
+                                      views::View* top_container) {
+    if (IsParentedTo(view, top_container)) {
+      top_container_layout.AddChild(view, gfx::Rect(), false);
+    }
+  };
+
+  if (views().window_scrim) {
+    layout.AddChild(views().window_scrim, bounds);
+  }
+
+  if (IsParentedTo(views().web_app_frame_toolbar, views().browser_view)) {
+    layout.AddChild(views().web_app_frame_toolbar, gfx::Rect(), false);
+  }
+  if (IsParentedTo(views().web_app_window_title, views().browser_view)) {
+    layout.AddChild(views().web_app_window_title, gfx::Rect(), false);
+  }
+  if (IsParentedTo(views().webui_tab_strip, views().browser_view)) {
+    layout.AddChild(views().webui_tab_strip, gfx::Rect(), false);
+  }
+  hide_browser_child(views().vertical_tab_strip_region_view);
+  hide_browser_child(views().projects_panel_container);
+  hide_browser_child(views().toolbar_height_side_panel);
+  hide_browser_child(views().contents_height_side_panel);
+  hide_browser_child(views().side_panel_animation_content);
+
+  if (IsParentedTo(views().main_background_region, views().browser_view)) {
+    layout.AddChild(views().main_background_region, bounds, false);
+  }
+  if (IsParentedTo(views().main_shadow_overlay, views().browser_view)) {
+    layout.AddChild(views().main_shadow_overlay, gfx::Rect(), false);
+  }
+
+  const HeliumNotchFullscreenMetrics metrics =
+      delegate().GetHeliumNotchFullscreenMetrics();
+  const int toolbar_height =
+      views().toolbar ? views().toolbar->GetPreferredSize().height() : 0;
+  const int tabstrip_height =
+      views().horizontal_tab_strip_region_view
+          ? views()
+                .horizontal_tab_strip_region_view->GetPreferredSize()
+                .height()
+          : 0;
+  const int top_strip_height = std::min(
+      bounds.height(),
+      std::max({kHeliumNotchFullscreenMinTopStripHeight,
+                metrics.top_strip_height, toolbar_height, tabstrip_height}));
+  const gfx::Rect top_container_bounds(bounds.x(), bounds.y(), bounds.width(),
+                                       top_strip_height);
+
+  auto segment_to_window = [&](gfx::Rect segment, bool left_segment) {
+    if (segment.IsEmpty()) {
+      const int half_width = bounds.width() / 2;
+      segment = left_segment
+                    ? gfx::Rect(0, 0, half_width, top_strip_height)
+                    : gfx::Rect(half_width, 0, bounds.width() - half_width,
+                                top_strip_height);
+    }
+    segment.set_y(0);
+    segment.set_height(top_strip_height);
+    segment.Offset(bounds.x(), bounds.y());
+    segment.Intersect(top_container_bounds);
+    return segment;
+  };
+
+  const gfx::Rect left_segment =
+      segment_to_window(metrics.top_left_area, /*left_segment=*/true);
+  const gfx::Rect right_segment =
+      segment_to_window(metrics.top_right_area, /*left_segment=*/false);
+
+  const TabStripType tab_strip_type = GetTabStripType();
+  const bool show_horizontal_tabs = delegate().ShouldLayoutTabStrip() &&
+                                    tab_strip_type == TabStripType::kHorizontal;
+
+  if (IsParentedTo(views().horizontal_tab_strip_region_view,
+                   views().browser_view)) {
+    gfx::Rect tabstrip_bounds;
+    if (show_horizontal_tabs) {
+      tabstrip_bounds = right_segment;
+    }
+    layout.AddChild(views().horizontal_tab_strip_region_view, tabstrip_bounds,
+                    show_horizontal_tabs && tabstrip_bounds.width() > 0);
+  }
+
+  if (IsParentedTo(views().top_container, views().browser_view)) {
+    auto& top_container_layout =
+        layout.AddChild(views().top_container, top_container_bounds, true);
+
+    hide_top_container_child(top_container_layout, views().webui_tab_strip,
+                             views().top_container);
+    hide_top_container_child(top_container_layout, views().bookmark_bar,
+                             views().top_container);
+    hide_top_container_child(top_container_layout, views().loading_bar,
+                             views().top_container);
+
+    if (IsParentedTo(views().toolbar, views().top_container)) {
+      gfx::Rect toolbar_bounds = left_segment;
+      toolbar_bounds.Offset(-top_container_bounds.x(),
+                            -top_container_bounds.y());
+      top_container_layout.AddChild(
+          views().toolbar, toolbar_bounds,
+          delegate().IsToolbarVisible() && toolbar_bounds.width() > 0);
+    }
+
+    if (IsParentedTo(views().horizontal_tab_strip_region_view,
+                     views().top_container)) {
+      gfx::Rect tabstrip_bounds;
+      if (show_horizontal_tabs) {
+        tabstrip_bounds = right_segment;
+        tabstrip_bounds.Offset(-top_container_bounds.x(),
+                               -top_container_bounds.y());
+      }
+      top_container_layout.AddChild(
+          views().horizontal_tab_strip_region_view, tabstrip_bounds,
+          show_horizontal_tabs && tabstrip_bounds.width() > 0);
+    }
+
+    if (IsParentedTo(views().top_container_separator, views().top_container)) {
+      const int separator_height =
+          views().top_container_separator->GetPreferredSize().height();
+      const gfx::Rect separator_bounds(
+          0, std::max(0, top_container_bounds.height() - separator_height),
+          top_container_bounds.width(), separator_height);
+      top_container_layout.AddChild(
+          views().top_container_separator, separator_bounds,
+          delegate().IsContentsSeparatorEnabled() && separator_height > 0);
+    }
+  }
+
+  if (IsParentedTo(views().top_container_separator, views().browser_view)) {
+    const int separator_height =
+        views().top_container_separator->GetPreferredSize().height();
+    const gfx::Rect separator_bounds(
+        bounds.x(),
+        std::max(bounds.y(), top_container_bounds.bottom() - separator_height),
+        bounds.width(), separator_height);
+    layout.AddChild(
+        views().top_container_separator, separator_bounds,
+        delegate().IsContentsSeparatorEnabled() && separator_height > 0);
+  }
+
+  int contents_top = top_container_bounds.bottom();
+  if (IsParentedTo(views().infobar_container, views().browser_view)) {
+    gfx::Rect infobar_bounds;
+    const bool infobar_visible = delegate().IsInfobarVisible();
+    if (infobar_visible) {
+      infobar_bounds =
+          gfx::Rect(bounds.x(), contents_top, bounds.width(),
+                    views().infobar_container->GetPreferredSize().height());
+      contents_top = infobar_bounds.bottom();
+    }
+    layout.AddChild(views().infobar_container, infobar_bounds, infobar_visible);
+  }
+
+  if (views().multi_contents_view) {
+    views().multi_contents_view->SetAttachedSideChromeVisibility(false, false);
+    views().multi_contents_view->SetShouldShowLeadingSeparator(false);
+    views().multi_contents_view->SetShouldShowTrailingSeparator(false);
+    views().multi_contents_view->SetShouldShowTopSeparator(false);
+    views().multi_contents_view->SetTargetContentBounds(std::nullopt);
+  }
+
+  if (IsParentedTo(views().contents_container, views().browser_view)) {
+    layout.AddChild(views().contents_container,
+                    gfx::Rect(bounds.x(), contents_top, bounds.width(),
+                              std::max(0, bounds.bottom() - contents_top)),
+                    true);
+  }
+
+  return layout;
+}
