@@ -0,0 +1,365 @@
+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/helium_notch_fullscreen_controller_mac.h"
+
+#include <AppKit/AppKit.h>
+#include <dispatch/dispatch.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/browser_widget.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+#include "ui/views/cocoa/native_widget_mac_ns_window_host.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+constexpr std::array<NSWindowButton, 3> kStandardWindowButtons = {
+    NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton};
+
+constexpr int kNotchFullscreenFallbackTopStripHeight = 28;
+
+int RoundCGFloat(CGFloat value) {
+  return static_cast<int>(std::round(value));
+}
+
+bool NSRectsNearlyEqual(NSRect lhs, NSRect rhs) {
+  constexpr CGFloat kTolerance = 1.0;
+  return std::abs(NSMinX(lhs) - NSMinX(rhs)) <= kTolerance &&
+         std::abs(NSMinY(lhs) - NSMinY(rhs)) <= kTolerance &&
+         std::abs(NSWidth(lhs) - NSWidth(rhs)) <= kTolerance &&
+         std::abs(NSHeight(lhs) - NSHeight(rhs)) <= kTolerance;
+}
+
+bool IsUsableWindowButtonFrame(NSRect frame) {
+  return NSMinX(frame) >= 0 && NSMinY(frame) >= 0 && NSWidth(frame) > 0 &&
+         NSHeight(frame) > 0;
+}
+
+gfx::Rect ScreenLocalRectFromNSRect(NSRect screen_frame, NSRect rect) {
+  gfx::Rect result(RoundCGFloat(NSMinX(rect) - NSMinX(screen_frame)),
+                   RoundCGFloat(NSMaxY(screen_frame) - NSMaxY(rect)),
+                   RoundCGFloat(NSWidth(rect)), RoundCGFloat(NSHeight(rect)));
+  gfx::Rect local_screen(0, 0, RoundCGFloat(NSWidth(screen_frame)),
+                         RoundCGFloat(NSHeight(screen_frame)));
+  result.Intersect(local_screen);
+  return result;
+}
+
+gfx::Rect GfxRectFromNSRect(NSRect rect) {
+  return gfx::Rect(RoundCGFloat(NSMinX(rect)), RoundCGFloat(NSMinY(rect)),
+                   RoundCGFloat(NSWidth(rect)), RoundCGFloat(NSHeight(rect)));
+}
+
+NSWindow* GetWindow(BrowserView* browser_view) {
+  if (!browser_view || !browser_view->GetWidget()) {
+    return nil;
+  }
+  return browser_view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+}
+
+remote_cocoa::mojom::NativeWidgetNSWindow* GetNSWindowMojo(
+    BrowserView* browser_view) {
+  if (!browser_view || !browser_view->GetWidget()) {
+    return nullptr;
+  }
+
+  auto* host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+      browser_view->GetWidget()->GetNativeWindow());
+  return host ? host->GetNSWindowMojo() : nullptr;
+}
+
+void RestoreStandardWindowButtons(NSWindow* window,
+                                  const std::array<NSRect, 3>& frames,
+                                  const std::array<CGFloat, 3>& alpha) {
+  for (size_t i = 0; i < kStandardWindowButtons.size(); ++i) {
+    if (NSButton* button =
+            [window standardWindowButton:kStandardWindowButtons[i]]) {
+      if (IsUsableWindowButtonFrame(frames[i])) {
+        [button setFrame:frames[i]];
+      }
+      [button setHidden:NO];
+      [button setEnabled:YES];
+      [button setAlphaValue:std::max<CGFloat>(1.0, alpha[i])];
+    }
+  }
+}
+
+HeliumNotchFullscreenMetrics GetScreenMetrics(NSScreen* screen) {
+  if (!screen) {
+    return {};
+  }
+
+  if (@available(macos 12.0, *)) {
+    const NSEdgeInsets safe_area_insets = [screen safeAreaInsets];
+    const NSRect screen_frame = [screen frame];
+    const gfx::Rect screen_bounds(0, 0, RoundCGFloat(NSWidth(screen_frame)),
+                                  RoundCGFloat(NSHeight(screen_frame)));
+
+    return CalculateHeliumNotchFullscreenMetrics(
+        screen_bounds,
+        ScreenLocalRectFromNSRect(screen_frame, [screen auxiliaryTopLeftArea]),
+        ScreenLocalRectFromNSRect(screen_frame, [screen auxiliaryTopRightArea]),
+        RoundCGFloat(safe_area_insets.top));
+  }
+
+  return {};
+}
+
+}  // namespace
+
+struct HeliumNotchFullscreenControllerMac::SavedState {
+  NSRect frame = NSZeroRect;
+  NSUInteger style_mask = 0;
+  NSWindowCollectionBehavior collection_behavior = 0;
+  NSApplicationPresentationOptions presentation_options = 0;
+  NSRect content_view_frame = NSZeroRect;
+  NSUInteger content_view_autoresizing_mask = 0;
+  int titlebar_height = 0;
+  std::array<NSRect, 3> standard_button_frame = {};
+  std::array<BOOL, 3> standard_button_hidden = {};
+  std::array<BOOL, 3> standard_button_enabled = {};
+  std::array<CGFloat, 3> standard_button_alpha = {};
+};
+
+HeliumNotchFullscreenMetrics CalculateHeliumNotchFullscreenMetrics(
+    const gfx::Rect& screen_bounds,
+    const gfx::Rect& top_left_area,
+    const gfx::Rect& top_right_area,
+    int safe_area_top) {
+  HeliumNotchFullscreenMetrics metrics;
+  if (safe_area_top <= 0 || top_left_area.IsEmpty() ||
+      top_right_area.IsEmpty() || top_left_area.right() >= top_right_area.x()) {
+    return metrics;
+  }
+
+  metrics.has_notch = true;
+  metrics.top_strip_height = std::max(
+      {safe_area_top, top_left_area.height(), top_right_area.height()});
+  metrics.top_strip_height =
+      std::min(metrics.top_strip_height, screen_bounds.height());
+
+  metrics.top_left_area = top_left_area;
+  metrics.top_left_area.set_y(0);
+  metrics.top_left_area.set_height(metrics.top_strip_height);
+  metrics.top_left_area.Intersect(screen_bounds);
+
+  metrics.top_right_area = top_right_area;
+  metrics.top_right_area.set_y(0);
+  metrics.top_right_area.set_height(metrics.top_strip_height);
+  metrics.top_right_area.Intersect(screen_bounds);
+
+  metrics.notch_gap =
+      gfx::Rect(metrics.top_left_area.right(), 0,
+                metrics.top_right_area.x() - metrics.top_left_area.right(),
+                metrics.top_strip_height);
+  metrics.notch_gap.Intersect(screen_bounds);
+  return metrics;
+}
+
+HeliumNotchFullscreenLayoutMetrics CalculateHeliumNotchFullscreenLayoutMetrics(
+    const gfx::Rect& bounds,
+    const HeliumNotchFullscreenMetrics& metrics,
+    int toolbar_height,
+    int tabstrip_height) {
+  HeliumNotchFullscreenLayoutMetrics layout;
+  layout.top_strip_height = std::min(
+      bounds.height(), std::max(metrics.top_strip_height,
+                                kNotchFullscreenFallbackTopStripHeight));
+  layout.contents_top = bounds.y() + layout.top_strip_height;
+
+  auto segment_to_window = [&](gfx::Rect segment, bool left_segment,
+                               int child_height, bool bottom_align_overflow) {
+    if (segment.IsEmpty()) {
+      const int half_width = bounds.width() / 2;
+      segment = left_segment
+                    ? gfx::Rect(0, 0, half_width, layout.top_strip_height)
+                    : gfx::Rect(half_width, 0, bounds.width() - half_width,
+                                layout.top_strip_height);
+    }
+    child_height = std::max(child_height, layout.top_strip_height);
+    const int overflow = child_height - layout.top_strip_height;
+    const int child_y =
+        bounds.y() -
+        (bottom_align_overflow ? overflow : std::max(0, overflow / 2));
+    segment.set_y(child_y);
+    segment.set_height(child_height);
+    segment.Offset(bounds.x(), 0);
+    const int segment_right = std::min(segment.right(), bounds.right());
+    segment.set_x(std::max(segment.x(), bounds.x()));
+    segment.set_width(std::max(0, segment_right - segment.x()));
+    return segment;
+  };
+
+  layout.toolbar_bounds =
+      segment_to_window(metrics.top_left_area, /*left_segment=*/true,
+                        toolbar_height, /*bottom_align_overflow=*/false);
+  layout.tabstrip_bounds =
+      segment_to_window(metrics.top_right_area, /*left_segment=*/false,
+                        tabstrip_height, /*bottom_align_overflow=*/true);
+  return layout;
+}
+
+HeliumNotchFullscreenControllerMac::HeliumNotchFullscreenControllerMac(
+    BrowserView* browser_view)
+    : browser_view_(browser_view) {}
+
+HeliumNotchFullscreenControllerMac::~HeliumNotchFullscreenControllerMac() {
+  Exit();
+}
+
+bool HeliumNotchFullscreenControllerMac::IsActive() const {
+  return active_;
+}
+
+bool HeliumNotchFullscreenControllerMac::CanUseNotchFullscreen() const {
+  NSWindow* window = GetWindow(browser_view_);
+  return GetScreenMetrics([window screen]).has_notch;
+}
+
+bool HeliumNotchFullscreenControllerMac::IsWindowOnExpectedFullscreenFrame()
+    const {
+  if (changing_window_state_) {
+    return true;
+  }
+  NSWindow* window = GetWindow(browser_view_);
+  NSScreen* screen = [window screen];
+  return window && screen && NSRectsNearlyEqual([window frame], [screen frame]);
+}
+
+void HeliumNotchFullscreenControllerMac::Enter() {
+  if (active_) {
+    return;
+  }
+
+  NSWindow* window = GetWindow(browser_view_);
+  NSScreen* screen = [window screen];
+  if (!GetScreenMetrics(screen).has_notch) {
+    return;
+  }
+  const NSRect target_frame = [screen frame];
+
+  auto saved_state = std::make_unique<SavedState>();
+  saved_state->frame = [window frame];
+  saved_state->style_mask = [window styleMask];
+  saved_state->collection_behavior = [window collectionBehavior];
+  saved_state->presentation_options = [NSApp presentationOptions];
+  saved_state->titlebar_height = std::max(
+      0, RoundCGFloat(
+             NSHeight(saved_state->frame) -
+             NSHeight([window contentRectForFrameRect:saved_state->frame])));
+  if (saved_state->titlebar_height == 0) {
+    saved_state->titlebar_height = RoundCGFloat(
+        NSHeight([NSWindow frameRectForContentRect:NSZeroRect
+                                         styleMask:NSWindowStyleMaskTitled]));
+  }
+  if (NSView* content_view = [window contentView]) {
+    saved_state->content_view_frame = [content_view frame];
+    saved_state->content_view_autoresizing_mask =
+        [content_view autoresizingMask];
+  }
+  for (size_t i = 0; i < kStandardWindowButtons.size(); ++i) {
+    if (NSButton* button =
+            [window standardWindowButton:kStandardWindowButtons[i]]) {
+      saved_state->standard_button_frame[i] = [button frame];
+      saved_state->standard_button_hidden[i] = [button isHidden];
+      saved_state->standard_button_enabled[i] = [button isEnabled];
+      saved_state->standard_button_alpha[i] = [button alphaValue];
+    }
+  }
+
+  saved_state_ = std::move(saved_state);
+  active_ = true;
+  changing_window_state_ = true;
+
+  [NSApp setPresentationOptions:saved_state_->presentation_options |
+                                NSApplicationPresentationAutoHideDock |
+                                NSApplicationPresentationAutoHideMenuBar];
+  const gfx::Rect screen_frame = gfx::ScreenRectFromNSRect(target_frame);
+  [window setStyleMask:NSWindowStyleMaskBorderless];
+  [window setFrame:target_frame display:YES animate:NO];
+  if (NSView* content_view = [window contentView]) {
+    NSView* superview = [content_view superview];
+    [content_view setFrame:superview ? [superview bounds]
+                                     : NSMakeRect(0, 0, NSWidth([window frame]),
+                                                  NSHeight([window frame]))];
+    [content_view setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
+  }
+  for (NSWindowButton standard_button : kStandardWindowButtons) {
+    if (NSButton* button = [window standardWindowButton:standard_button]) {
+      [button setHidden:YES];
+      [button setEnabled:NO];
+      [button setAlphaValue:0.0];
+    }
+  }
+  if (auto* ns_window_mojo = GetNSWindowMojo(browser_view_)) {
+    gfx::Rect adjusted_screen_frame = screen_frame;
+    adjusted_screen_frame.set_y(screen_frame.y() +
+                                saved_state_->titlebar_height);
+    adjusted_screen_frame.set_height(
+        std::max(0, screen_frame.height() - saved_state_->titlebar_height));
+    ns_window_mojo->SetStyleMask(NSWindowStyleMaskBorderless);
+    ns_window_mojo->SetWindowFrame(adjusted_screen_frame);
+    ns_window_mojo->SetContentViewFrame(
+        gfx::Rect(0, 0, screen_frame.width(), screen_frame.height()));
+    ns_window_mojo->SetWindowButtonsHidden(true);
+  }
+  [window makeKeyAndOrderFront:nil];
+  changing_window_state_ = false;
+}
+
+void HeliumNotchFullscreenControllerMac::Exit() {
+  if (!active_) {
+    return;
+  }
+
+  NSWindow* window = GetWindow(browser_view_);
+  if (saved_state_) {
+    auto saved_state = std::move(saved_state_);
+    changing_window_state_ = true;
+    active_ = false;
+    [NSApp setPresentationOptions:saved_state->presentation_options];
+    if (window) {
+      [window setStyleMask:saved_state->style_mask];
+      [window setCollectionBehavior:saved_state->collection_behavior];
+      [window setFrame:saved_state->frame display:YES animate:NO];
+      if (NSView* content_view = [window contentView]) {
+        [content_view setFrame:saved_state->content_view_frame];
+        [content_view
+            setAutoresizingMask:saved_state->content_view_autoresizing_mask];
+      }
+      RestoreStandardWindowButtons(window, saved_state->standard_button_frame,
+                                   saved_state->standard_button_alpha);
+      const std::array<NSRect, 3> button_frame =
+          saved_state->standard_button_frame;
+      const std::array<CGFloat, 3> button_alpha =
+          saved_state->standard_button_alpha;
+      NSWindow* restore_window = window;
+      dispatch_async(dispatch_get_main_queue(), ^{
+        RestoreStandardWindowButtons(restore_window, button_frame,
+                                     button_alpha);
+      });
+    }
+    if (auto* ns_window_mojo = GetNSWindowMojo(browser_view_)) {
+      ns_window_mojo->SetStyleMask(saved_state->style_mask);
+      ns_window_mojo->SetContentViewFrame(
+          GfxRectFromNSRect(saved_state->content_view_frame));
+      ns_window_mojo->SetWindowButtonsHidden(false);
+    }
+    changing_window_state_ = false;
+  }
+}
+
+HeliumNotchFullscreenMetrics HeliumNotchFullscreenControllerMac::GetMetrics()
+    const {
+  NSWindow* window = GetWindow(browser_view_);
+  HeliumNotchFullscreenMetrics metrics = GetScreenMetrics([window screen]);
+  metrics.active = active_ && metrics.has_notch;
+  return metrics;
+}
