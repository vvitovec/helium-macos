+
+// Testable geometry helper. All rectangles are in screen-local DIP coordinates
+// with a top-left origin, matching Views layout coordinates.
+HeliumNotchFullscreenMetrics CalculateHeliumNotchFullscreenMetrics(
+    const gfx::Rect& screen_bounds,
+    const gfx::Rect& top_left_area,
+    const gfx::Rect& top_right_area,
+    int safe_area_top);
+
+HeliumNotchFullscreenLayoutMetrics CalculateHeliumNotchFullscreenLayoutMetrics(
+    const gfx::Rect& bounds,
+    const HeliumNotchFullscreenMetrics& metrics,
+    int toolbar_height,
+    int tabstrip_height);
+
+// Controls Helium's custom macOS notch fullscreen mode. This class
+// intentionally uses only public AppKit APIs and never enters native macOS
+// fullscreen.
+class HeliumNotchFullscreenControllerMac {
+ public:
+  explicit HeliumNotchFullscreenControllerMac(BrowserView* browser_view);
+  HeliumNotchFullscreenControllerMac(
+      const HeliumNotchFullscreenControllerMac&) = delete;
+  HeliumNotchFullscreenControllerMac& operator=(
+      const HeliumNotchFullscreenControllerMac&) = delete;
+  ~HeliumNotchFullscreenControllerMac();
+
+  bool IsActive() const;
+  bool CanUseNotchFullscreen() const;
+  bool IsWindowOnExpectedFullscreenFrame() const;
+  void Enter();
+  void Exit();
+  HeliumNotchFullscreenMetrics GetMetrics() const;
+
+ private:
+  struct SavedState;
+
+  raw_ptr<BrowserView> browser_view_;
+  std::unique_ptr<SavedState> saved_state_;
+  bool active_ = false;
+  bool changing_window_state_ = false;
+};
+
